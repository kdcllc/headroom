    "snap.retain": act_snap_retain,
    "snap.cache": act_snap_cache,
    "crash.var": act_crash_var,
    "crash.coredump": act_crash_coredump,
    "tmp.var": act_tmp_var,
    "tmp.tmp": act_tmp_tmp,
    "cache.man": act_cache_man,
    "cache.fontconfig": act_cache_fontconfig,
