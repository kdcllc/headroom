    "docker.volumes": act_docker_volumes,
}
assert set(ACTIONS) == set(PARAMS)

# actions whose size can be computed with a dry walk
DRY_SIZERS = {
    "logs.rotated": act_logs_rotated,
    "logs.truncate_large": act_logs_truncate_large,
    "snap.cache": act_snap_cache,
    "crash.var": act_crash_var,
    "crash.coredump": act_crash_coredump,
    "tmp.var": act_tmp_var,
    "tmp.tmp": act_tmp_tmp,
    "cache.man": act_cache_man,
    "cache.fontconfig": act_cache_fontconfig,
}


def scan():
    """Sizes for root-only items. Read-only."""
    out = []
    defaults = {aid: {k: v[3] for k, v in spec.items()} for aid, spec in PARAMS.items()}
    out.append({"id": "apt.clean", "size_bytes": _apt_archive_size()})
    _, usage, _ = run(["journalctl", "--disk-usage"], timeout=60)
    out.append({"id": "journal.vacuum", "size_bytes": parse_journal_usage(usage)})
    out.append({"id": "snap.disabled",
                "size_bytes": sum(_snap_size(n, r) for n, r in _disabled_snaps())})
    for aid, fn in DRY_SIZERS.items():
        try:
            out.append({"id": aid, "size_bytes": fn(defaults[aid], dry=True)["freed_bytes"]})
        except OSError:
            pass
    if have("docker"):
        rc, df, _ = run(["docker", "system", "df", "--format", "{{json .}}"], timeout=120)
        if rc == 0:
            d = parse_docker_df(df)
            out.append({"id": "docker.builder", "size_bytes": d.get("Build Cache", 0)})
            out.append({"id": "docker.system", "size_bytes": d.get("Containers", 0) + d.get("Build Cache", 0)})
            out.append({"id": "docker.images_all", "size_bytes": d.get("Images", 0)})
            out.append({"id": "docker.volumes", "size_bytes": d.get("Local Volumes", 0)})
    return out


def execute(plan):
    lines = []
    for aid, params in plan:
        try:
            lines.append(ACTIONS[aid](params))
        except Exception as exc:  # report and continue with the next action
            lines.append(result(aid, False, 0, f"{type(exc).__name__}: {exc}"))
        print(json.dumps(lines[-1]), flush=True)
    return lines


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    if argv == ["--version"]:
        print(VERSION)
        return 0
    if argv not in (["--scan"], ["--plan-stdin"]):
        print("usage: headroom-helper --scan | --plan-stdin", file=sys.stderr)
        return 2
    if os.geteuid() != 0:
        print("headroom-helper must run as root (via pkexec)", file=sys.stderr)
        return 2
    os.umask(0o022)
    os.chdir("/")
    if argv == ["--scan"]:
        for line in scan():
            print(json.dumps(line), flush=True)
        return 0
    raw = sys.stdin.read(MAX_PLAN_BYTES + 1)
    if len(raw) > MAX_PLAN_BYTES:
        print(json.dumps({"id": None, "ok": False, "error": "plan too large"}), flush=True)
        return 2
    try:
        plan = validate_plan(json.loads(raw))
    except (ValueError, PlanError) as exc:
        print(json.dumps({"id": None, "ok": False, "error": str(exc)}), flush=True)
        return 2
    lines = execute(plan)
    return 0 if all(line["ok"] for line in lines) else 1


if __name__ == "__main__":
    sys.exit(main())
