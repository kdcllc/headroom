[
  {
    "id": "slack", "label": "Slack", "category": "Electron Apps", "template": "chromium_app",
    "vars": {"root": ["~/.config/Slack", "~/snap/slack/current/.config/Slack",
                      "~/.var/app/com.slack.Slack/config/Slack"]},
    "running": {"process_names": ["slack"], "snap_names": ["slack"], "flatpak_ids": ["com.slack.Slack"]}
  },
  {
    "id": "discord", "label": "Discord", "category": "Electron Apps", "template": "chromium_app",
    "vars": {"root": ["~/.config/discord", "~/.config/discordcanary", "~/.config/discordptb",
                      "~/snap/discord/current/.config/discord",
                      "~/.var/app/com.discordapp.Discord/config/discord"]},
    "running": {"process_names": ["Discord", "discord", "DiscordCanary", "DiscordPTB"],
                "snap_names": ["discord"], "flatpak_ids": ["com.discordapp.Discord"]}
  },
  {
    "id": "teams", "label": "Microsoft Teams / teams-for-linux", "category": "Electron Apps",
