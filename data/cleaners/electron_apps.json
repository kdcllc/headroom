                      "~/.var/app/org.signal.Signal/config/Signal"]},
    "running": {"process_names": ["signal-desktop", "Signal"], "snap_names": ["signal-desktop"],
                "flatpak_ids": ["org.signal.Signal"]}
  },
  {
    "id": "element", "label": "Element", "category": "Electron Apps", "template": "chromium_app",
    "vars": {"root": ["~/.config/Element", "~/snap/element-desktop/current/.config/Element",
                      "~/.var/app/im.riot.Riot/config/Element"]},
    "running": {"process_names": ["element-desktop", "Element"], "snap_names": ["element-desktop"],
                "flatpak_ids": ["im.riot.Riot"]}
