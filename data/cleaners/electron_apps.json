    "running": {"process_names": ["obsidian"], "snap_names": ["obsidian"],
                "flatpak_ids": ["md.obsidian.Obsidian"]}
  },
  {
    "id": "postman", "label": "Postman", "category": "Electron Apps", "template": "chromium_app",
    "vars": {"root": ["~/.config/Postman", "~/snap/postman/current/.config/Postman",
                      "~/.var/app/com.getpostman.Postman/config/Postman"]},
