  {
    "id": "azuredatastudio", "label": "Azure Data Studio", "category": "Electron Apps",
    "template": "chromium_app",
    "vars": {"root": ["~/.config/azuredatastudio"]},
    "running": {"process_names": ["azuredatastudio"]}
  },
  {
    "id": "spotify", "label": "Spotify", "category": "Electron Apps",
    "running": {"process_names": ["spotify"], "snap_names": ["spotify"], "flatpak_ids": ["com.spotify.Client"]},
    "options": [
      {
        "id": "spotify.cache",
        "label": "Streaming cache",
        "description": "Cached audio (Storage/, Data/) can be several GB. Downloaded offline playlists will download again.",
        "rating": "safe",
        "requires_app_closed": true,
        "targets": [
          {"mode": "contents", "path": "~/.cache/spotify"},
          {"mode": "contents", "path": "~/snap/spotify/common/.cache/spotify"},
          {"mode": "contents", "path": "~/.var/app/com.spotify.Client/cache/spotify"}
        ]
      }
    ]
  }
]
